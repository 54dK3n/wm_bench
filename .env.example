# Copy to .env.local and fill in your provider's Chat Completions configuration.
# No shell export is needed. Existing process environment values take priority.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional; the task's original sampling requirement remains the default.
LLM_TEMPERATURE=0
# Omit unless supported by the chosen model; allowed: enabled or disabled.
# LLM_THINKING=disabled
