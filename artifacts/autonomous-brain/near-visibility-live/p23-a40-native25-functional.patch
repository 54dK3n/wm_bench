+        assert source["observation"]["detections"]
+    assert r.audit()["failures"] == []
+
+
+@pytest.mark.parametrize("fault", ["partial", "unknown", "forward-unknown"])
+def test_missing_probe_failed_or_unknown_motion_does_not_learn_or_repeat(fault):
