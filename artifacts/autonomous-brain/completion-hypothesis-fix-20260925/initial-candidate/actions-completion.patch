+RETIREMENT_EVIDENCE_FIELDS = ("reason", "archived", "confirmed_s", "first_seen_s",
+                              "last_seen_s", "last_updated_s", "first_seen_frame_id",
+                              "last_frame_id", "hit_count", "confidence")
