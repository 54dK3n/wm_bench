+                position_source="successful_release_pose_and_public_release_projection",
+                storage_anchor=dict(mission["storage"]),
+                exclusion_radius_m=float(wm.assoc_cfg.gate_distance_m),
+                delivered_count=len(DEMO_STATE["deliveries"]))
+    return True
