    def test_2_5_released_distractor_old_position_goes_stale(layouts_task2, wm_factory, classify):
        """第二个天然世界变更：混淆物被移到 1.2 m 外后，旧位置轨迹 3 s 内离开 CONFIRMED，新位置出现轨迹。"""
        failures = []
        for i, layout in enumerate(layouts_task2[:5]):
            frames, _, meta = build_release_scenario(layout, seed=700 + i)
            log = harness.run_wm(frames, wm_factory())
            obj = meta["object"]
            before = log.before(meta["t_release"])
            old = [tr for tr in before.tracks if tr.state == CONFIRMED and classify(tr) == "distractor" and tr.dist(obj.x, obj.z) <= 0.5]
            if not old:
                failures.append(f"{layout.map_id}: 释放前旧位置没有 CONFIRMED 轨迹")
                continue
            after = log.at_or_after(meta["t_release"] + 3.0)
            old_after = after.by_id(old[0].obj_id)
            nx, nz = meta["new_pos"]
            new_tracks = [tr for tr in log.frames[-1].tracks if classify(tr) == "distractor" and tr.dist(nx, nz) <= 0.5 and tr.state in harness.ACTIVE_STATES]
            if old_after is not None and old_after.state == CONFIRMED and old_after.dist(obj.x, obj.z) <= 0.5:
                failures.append(f"{layout.map_id}: 释放后 3 s 旧位置轨迹仍 CONFIRMED（conf={old_after.confidence:.2f}）")
            if not new_tracks:
                failures.append(f"{layout.map_id}: 释放后新位置没有活跃轨迹")
