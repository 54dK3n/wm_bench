        layout = layouts_task2[1]
        frames, _, meta = build_grab_scenario(layout, seed=810, post_grab_hold_s=20.0)
        log = harness.run_wm(frames, wm_factory())
        wm = log.wm
        snapshot = wm.snapshot()
        recs = to_scene_observations(snapshot)
        assert len(recs) == len(snapshot)
        for rec in recs:
            # 契约允许对坐标做四舍五入，容差 1 mm
            assert any(abs(float(rec["x"]) - float(o.x)) < 1e-3 and abs(float(rec["z"]) - float(o.z)) < 1e-3 for o in snapshot), \
                f"契约记录坐标 {rec['x'], rec['z']} 不在快照中"
