    def test_2_7_robust_to_odometry_noise(layouts_task2, wm_factory, classify, record):
        """里程计叠加 2% 距离噪声（每步位移相对高斯）+ 每次转向 1° 持久航向噪声：
        CONFIRMED 轨迹终态定位误差中位数 ≤ 30 cm，且错并仍为 0。"""
        noise = OdomNoise(distance_rel_std=0.02, heading_deg_std_per_turn=1.0)
        errors_all: List[float] = []
        merges_total = 0
        details = []
        for i, layout in enumerate(layouts_task2):
            frames, _ = build_tour(layout, seed=900 + i, odom=noise)
            log = harness.run_wm(frames, wm_factory())
            errs = harness.localization_errors(log.frames[-1].tracks, layout, classify, states=harness.ACTIVE_STATES)
            _, track_to_truths = harness.truth_associations(log, layout, classify, harness.match_radius(layout))
            merges = harness.merge_count(track_to_truths)
            merges_total += merges
            errors_all += errs
            details.append({"map": layout.map_id, "median_cm": round(100 * statistics.median(errs), 1) if errs else None,
                            "p90_cm": round(100 * harness.percentile(errs, 0.9), 1) if errs else None, "tracks": len(errs), "merges": merges})
        median_cm = 100 * statistics.median(errors_all) if errors_all else math.inf
        p90_cm = 100 * harness.percentile(errors_all, 0.9) if errors_all else math.inf
        record("2_7", {"median_cm": median_cm, "p90_cm": p90_cm, "merges": merges_total,
                       "noise": {"distance_rel_std": 0.02, "heading_deg_std_per_turn": 1.0}, "details": details})
        assert errors_all, "没有任何活跃轨迹，无法评估"
        assert median_cm <= 30.0, f"2.7 有噪定位误差中位数 {median_cm:.1f} cm，门限 ≤ 30 cm（P90 {p90_cm:.1f} cm）。明细：{details}"
