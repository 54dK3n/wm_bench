    def test_2_6_wm_to_contract_outputs_confirmed_tracks(layouts_task2, wm_factory, record):
        """规格公开 API wm.to_contract() 也是契约出口：快照中存在 CONFIRMED 轨迹时它不得为空，且字段合法。"""
        problems: List[str] = []
