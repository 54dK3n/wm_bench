    def test_2_6_wm_to_contract_outputs_confirmed_tracks(layouts_task2, wm_factory, record):
        """规格公开 API wm.to_contract() 也是契约出口：快照中存在 CONFIRMED 轨迹时它不得为空，且字段合法。"""
        problems: List[str] = []
        observed = []
        for frame, snapshot, wm in _contract_checkpoints(layouts_task2[0], wm_factory()):
            confirmed = [o for o in snapshot if ObjectState(o.state) == CONFIRMED]
            if not confirmed:
                continue
            # 用最宽松的参数调用，排除阈值/时效/尺寸信任过滤的影响
            wm_contract = wm.to_contract(min_confidence=0.0, max_staleness_s=1e9, now=frame.t, require_size_trusted=False)
            observed.append({"frame": frame.index, "confirmed": len(confirmed), "contract": len(wm_contract)})
            if not wm_contract:
                problems.append(f"帧{frame.index}: 快照有 {len(confirmed)} 条 CONFIRMED 轨迹，wm.to_contract() 却返回空列表")
            problems += [f"帧{frame.index} to_contract: {p}" for p in harness.validate_contract_records(wm_contract)]
        record("2_6_to_contract", {"observed": observed, "problems": problems})
        assert observed, "前置条件：整局没有出现 CONFIRMED 轨迹"
