    def test_2_2_single_frame_detection_is_not_confirmed(wm_factory, classify):
        """规格 5：新检测需连续命中若干次才能 CONFIRMED；单帧误检不得立即成为 CONFIRMED。
        构造：一个真实物体持续可见 + 一个只出现 1 帧的幽灵。幽灵在其出现帧及后续任一帧都不得为 CONFIRMED。"""
        from tests.acceptance.synth import ScriptedRobot, SyntheticWorld
        layout = _pair_layout(3.0)          # 两个 target 相距 3 m：左边的是真实物体，右边的用作单帧幽灵
        real, ghost = layout.objects
        world = SyntheticWorld(layout, seed=77, sensor=SensorNoise(miss_rate=0.0, ghost_rate=0.0))
        world.get(ghost.oid).present = False
        robot = ScriptedRobot(world, seed=77)
        robot.hold(2.0)
        world.get(ghost.oid).present = True
        robot.hold(0.5)                      # 幽灵恰好出现 1 帧
        world.get(ghost.oid).present = False
        robot.hold(3.0)
        log = harness.run_wm(robot.frames, wm_factory())
        ghost_confirmed = [(f.t, tr.obj_id) for f in log.frames for tr in f.tracks
                           if tr.state == CONFIRMED and classify(tr) == "target" and tr.dist(ghost.x, ghost.z) <= 0.5]
        real_confirmed = any(tr.state == CONFIRMED and tr.dist(real.x, real.z) <= 0.5 for tr in log.frames[-1].tracks)
        assert real_confirmed, "前置条件：持续可见的真实物体在结束时应为 CONFIRMED"
