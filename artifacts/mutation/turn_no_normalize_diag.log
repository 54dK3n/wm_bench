            (_odom(0, 0, 0), _obs("target", 0.0, 100), 0.0, 1.0),
            (_odom(0, 0, 0), _obs("target", 30.0, 200), 2 * math.sin(math.radians(30)), 2 * math.cos(math.radians(30))),
            (_odom(100, 50, 0), _obs("target", 0.0, 100), 0.5, 2.0),
            (_odom(0, 0, 90), _obs("target", 0.0, 100), -1.0, 0.0),     # 左转 90° 后正前方 = 起点帧 -x
            (_odom(0, 0, -90), _obs("target", 0.0, 100), 1.0, 0.0),     # 右转 90° 后正前方 = 起点帧 +x
