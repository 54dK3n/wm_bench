    def test_2_5_out_of_fov_object_is_not_fast_decayed(layouts_task2, wm_factory, classify):
        """对照：同一时刻，一个离开视野约 10 s 的对照物必须仍为 CONFIRMED（无漏检/无幽灵，隔离随机漏检的影响）。
        把视野外衰减也调快的实现能过主断言，但过不了这条。"""
        checked = 0
        failures = []
        clean = SensorNoise(miss_rate=0.0, ghost_rate=0.0)
        for i, layout in enumerate(layouts_task2):
            frames, _, meta = build_grab_scenario(layout, seed=500 + i, sensor=clean, post_grab_hold_s=3.5)
            if meta["control_in_fov_at_grab"]:
                continue
            log = harness.run_wm(frames, wm_factory())
            control = meta["control"]
            before = log.before(meta["t_grab"])
            pre = [tr for tr in before.tracks if classify(tr) == "distractor" and tr.dist(control.x, control.z) <= 0.5]
            if not pre or pre[0].state != CONFIRMED:
                failures.append(f"{layout.map_id}: 抓取前对照物轨迹不是 CONFIRMED（{[(p.state.value, round(p.confidence, 2)) for p in pre]}）")
                continue
            checked += 1
            after = log.at_or_after(meta["t_grab"] + 3.0).by_id(pre[0].obj_id)
            if after is None or after.state != CONFIRMED:
                failures.append(f"{layout.map_id}: 视野外对照物在 t={meta['t_grab'] + 3.0}s 状态 {after.state.value if after else 'LOST'}，期望 CONFIRMED")
        assert checked >= 6, f"对照用例有效局数不足（{checked}），场景脚本需要调整"
